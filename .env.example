# Copy to .env.local for local development. In Vercel, add these under
# Project > Settings > Environment Variables. Never commit real values.
# NEXT_PUBLIC_* values are visible in the browser by design; everything else is server-only.

# --- Public website (Phase 3) -------------------------------------------
# Canonical site address used for SEO, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://dtescortservice.com

# Web3Forms access key (https://web3forms.com). Public by design; restrict the
# allowed domain to dtescortservice.com in the Web3Forms dashboard.
# Optional: the key is already set in src/lib/forms.ts. Only fill this to override it.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Maps Embed API key (free, no usage limit). Restrict by HTTP referrer
# to https://dtescortservice.com/* and your Vercel preview domain.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Portal (Phase 4+) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to create driver accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email). Verify dtescortservice.com in Resend first.
RESEND_API_KEY=
RESEND_FROM="D & T Escort Service <dispatch@dtescortservice.com>"
RESEND_WEBHOOK_SECRET=

# Stripe (online invoice payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Daily job (expiry alerts, overdue invoices, owner digest). Any long random string;
# Vercel sends it automatically to /api/cron/daily.
CRON_SECRET=

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dtescortservice@gmail.com

# Quo (formerly OpenPhone): calls and texts inbox. Create a webhook in Quo pointing to
# https://dtescortservice.com/api/webhooks/quo (message + call events) and paste its signing secret.
QUO_WEBHOOK_SECRET=
# Optional: only keep calls/texts on this number (defaults to the dispatch number in src/lib/site.ts).
QUO_ONLY_NUMBER=

# Bouncie vehicle tracking (https://bouncie.dev): create an app, then copy its client ID, client secret,
# the redirect URL you set on the app, and the authorization code from "Users & Devices".
BOUNCIE_CLIENT_ID=
BOUNCIE_CLIENT_SECRET=
BOUNCIE_AUTH_CODE=
BOUNCIE_REDIRECT_URI=https://dtescortservice.com/portal/map
